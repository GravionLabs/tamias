{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tamias",
  "mainBinaryName": "tamias-app",
  "identifier": "io.gravionlabs.tamias",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/tamias-app/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tamias",
        "width": 960,
        "height": 880,
        "minWidth": 640,
        "minHeight": 840,
        "visible": false
      },
      {
        "label": "tray",
        "title": "tamias usage",
        "url": "index.html#/tray",
        "width": 320,
        "height": 200,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Today's usage against the daily budget per provider",
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/tamias"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/GravionLabs/tamias/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZEQzA0ODg3RTA0NTQyMDgKUldRSVFrWGdoMGpBL1RZdmF3RHRqa0MzUkpVb3RTak5MaVkwMEVyeGN2TllUeDhUSC9tV3hRdmkK"
    }
  }
}
