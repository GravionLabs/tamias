{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tamias",
  "mainBinaryName": "tamias-app",
  "identifier": "dev.gravionlabs.tamias",
  "build": {
    "beforeDevCommand": "pnpm start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist/tamias-app/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tamias",
        "width": 820,
        "height": 600,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
